ORBIT_BASE_URL=http://localhost
ORBIT_VERSION=latest
ORBIT_PULL_POLICY=build
ORBIT_SECRET_KEY=
ORBIT_ALLOWED_EMAILS=
ORBIT_DEMO_MODE=
# Free-tier limits. 0 or empty means no limit.
# Most spaces one person can create.
ORBIT_MAX_CREATED_SPACES=
# Most update emails one person gets in 24 hours. Extras go into their morning summary.
ORBIT_MAX_UPDATE_EMAILS_PER_DAY=
DATABASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Or send through Resend's HTTPS API instead of SMTP (takes precedence when set).
RESEND_API_KEY=
EMAIL_FROM=Orbit <orbit@localhost>
# Combine and template drafts need one AI provider. Set one of the three below, or several and pick with ORBIT_AI_PROVIDER.
ANTHROPIC_API_KEY=
COMBINE_MODEL=claude-opus-5-5
# AI uses each person gets per month (one Combine or one start-from-a-sentence is one use). 0 = no limit.
ORBIT_FREE_AI_USES=20
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# true when GEMINI_API_KEY is a Vertex AI (Google Cloud) key rather than a Gemini API key.
GEMINI_USE_VERTEX=
# Any OpenAI-compatible server: OpenAI, OpenRouter, or a local model through Ollama, LM Studio or vLLM.
# OPENAI_MODEL is required. Set OPENAI_API_KEY for a hosted service, or OPENAI_BASE_URL for your own server.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# anthropic, gemini or openai. Empty means Anthropic when its key is set, then Gemini, then an OpenAI-compatible server.
ORBIT_AI_PROVIDER=
# Paid plans through Stripe. Billing stays off unless all six are set. Stripe test keys start sk_test_.
# Create a recurring monthly and yearly price for Plus and a one-off price for each pack, then paste the price ids (price_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_AI_PACK=
STRIPE_PRICE_EMAIL_PACK=
SENTRY_DSN=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=orbit/
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ORBIT_OPERATOR_NAME=
ORBIT_CONTACT_EMAIL=
ORBIT_DATA_LOCATION=
